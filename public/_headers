# The Google sign-in runs in a popup and has to be able to talk to the page
# that opened it. The stricter default severs that, and the sign-in hangs
# with "would block the window.closed call" in the console.
/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# The service worker is how a new version is noticed at all, so it is never
# served from a cache: a stale one would report the build it was cached with
# and the app would sit on an old version until something else expired.
/sw.js
  Cache-Control: no-cache
