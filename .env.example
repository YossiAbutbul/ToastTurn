# Firebase — copy to .env.local and fill in from the Firebase console
# (Project settings → General → Your apps → Web app → SDK setup and configuration).
# Without these the app runs exactly as before: local to one phone, still offline.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: point at a local emulator instead of the real project.
# VITE_FIREBASE_EMULATOR=127.0.0.1:8080

# Optional: App Check, from the console (App Check -> Apps -> reCAPTCHA v3).
# Without it the app runs exactly as before; with it, the project only answers
# calls that came from this app in a real browser.
VITE_FIREBASE_APPCHECK_KEY=
