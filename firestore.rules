rules_version = '2';

// Two ideas, and only two.
//
// 1. The family code is the key. You have to know a family id to read it, and
//    nothing can list families, so a code that is never shared is never found.
//    Anyone with the link can read the family and say the toast got made, no
//    sign-in, nothing typed. That is the whole point of the app.
// 2. One account runs the family. Only the signed-in owner can change the
//    people, the schedule or the rotation, or clear the family.
service cloud.firestore {
  match /databases/{database}/documents {

    match /families/{familyId} {
      function sane() {
        return request.resource.data.name is string
          && request.resource.data.name.size() < 60
          && request.resource.data.people is list
          && request.resource.data.people.size() <= 20;
      }

      function isOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }

      allow get: if true;
      allow list: if false;

      // Publishing a family claims it for the account doing the publishing.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && sane();

      // The owner stays the owner: a write that moves ownerUid is refused.
      allow update: if isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && sane();

      allow delete: if isOwner();

      // Who is in the rotation, by account: { uid: { status, personId, email } }.
      //
      // Having the link lets you ask. It does not let you in: you may only ever
      // write your own key, and only as "pending". Moving anyone to "approved"
      // is the owner's alone, and so is choosing a person once approved.
      match /prefs/members {
        function ownerUid() {
          return get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid;
        }
        function isOwner() {
          return request.auth != null && ownerUid() == request.auth.uid;
        }

        function mine() {
          return request.resource.data[request.auth.uid];
        }
        function myKeyOnly() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]);
        }
        function alreadyApproved() {
          return resource.data.keys().hasAny([request.auth.uid])
            && resource.data[request.auth.uid].status == 'approved';
        }

        allow get, list: if true;

        // The owner writes this doc freely, it is how they let people in.
        allow create: if isOwner()
          || (request.auth != null
              && request.resource.data.keys().hasOnly([request.auth.uid])
              && mine().status == 'pending');

        allow update: if isOwner()
          || (request.auth != null && myKeyOnly()
              && ((mine().status == 'pending' && !alreadyApproved())
                  || (mine().status == 'approved' && alreadyApproved())));

        allow delete: if isOwner();
      }

      // Which slices have been made: { personId: [0, 2] }.
      //
      // Whoever is making the toast ticks off everyone's, and the maker is
      // whoever's turn it is rather than whoever runs the rotation. So this
      // board is open to the whole family, unlike the orders themselves,
      // which stay each person's own.
      match /prefs/made {
        function familyOwner() {
          return request.auth != null
            && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
        }

        function approvedMember() {
          return request.auth != null
            && exists(/databases/$(database)/documents/families/$(familyId)/prefs/members)
            && get(/databases/$(database)/documents/families/$(familyId)/prefs/members)
                 .data.keys().hasAny([request.auth.uid])
            && get(/databases/$(database)/documents/families/$(familyId)/prefs/members)
                 .data[request.auth.uid].status == 'approved';
        }

        allow get, list: if true;
        allow create, update: if familyOwner() || approvedMember();
        allow delete: if familyOwner();
      }

      // What everyone wants, by person: { personId: { toastiness, butter } }.
      //
      // Keyed by person rather than by account, because half a family has no
      // phone: the owner puts an order in for a child who cannot. Everyone
      // else is held to the one line that belongs to them, which means looking
      // up which person they are before letting the write through.
      match /prefs/orders {
        function familyOwner() {
          return request.auth != null
            && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
        }

        function membership() {
          return get(/databases/$(database)/documents/families/$(familyId)/prefs/members)
                   .data[request.auth.uid];
        }

        function approvedMember() {
          return request.auth != null
            && exists(/databases/$(database)/documents/families/$(familyId)/prefs/members)
            && get(/databases/$(database)/documents/families/$(familyId)/prefs/members)
                 .data.keys().hasAny([request.auth.uid])
            && membership().status == 'approved';
        }

        // Whoever is making it has to be able to read the lot, signed in or not.
        allow get, list: if true;

        allow create: if familyOwner()
          || (approvedMember()
              && request.resource.data.keys().hasOnly([membership().personId]));

        allow update: if familyOwner()
          || (approvedMember()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly([membership().personId]));

        allow delete: if familyOwner();
      }

      // Asking someone to take your turn: { id: { from, to, date, status } }.
      //
      // The board is a place to leave a note, not a way around the owner. It
      // cannot move the rotation by itself: an accepted ask is still applied
      // by the owner's phone, writing the family document as it always did.
      match /prefs/swaps {
        function familyOwner() {
          return request.auth != null
            && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
        }

        function approvedMember() {
          return request.auth != null
            && exists(/databases/$(database)/documents/families/$(familyId)/prefs/members)
            && get(/databases/$(database)/documents/families/$(familyId)/prefs/members)
                 .data.keys().hasAny([request.auth.uid])
            && get(/databases/$(database)/documents/families/$(familyId)/prefs/members)
                 .data[request.auth.uid].status == 'approved';
        }

        // A board nobody could read would be a board nobody could answer.
        allow get, list: if true;

        // Only people who are actually in the rotation may ask or answer.
        allow create, update: if familyOwner() || approvedMember();

        // Only as part of the owner clearing the whole family.
        allow delete: if familyOwner();
      }

      match /turns/{turnId} {
        function saneTurn() {
          return request.resource.data.personId is string
            && request.resource.data.madeAt is string
            && request.resource.data.skipped is bool;
        }

        // Listing turns needs the family id in the path, so it stays scoped.
        allow get, list: if true;

        // Anyone in the family can log toast without signing in.
        // `resource` here is the turn, not the family, so the owner has to be
        // looked up rather than read off the document being written.
        function familyOwner() {
          return request.auth != null
            && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
        }

        // Logging toast is for people who were let in.
        function approvedMember() {
          return request.auth != null
            && exists(/databases/$(database)/documents/families/$(familyId)/prefs/members)
            && get(/databases/$(database)/documents/families/$(familyId)/prefs/members)
                 .data.keys().hasAny([request.auth.uid])
            && get(/databases/$(database)/documents/families/$(familyId)/prefs/members)
                 .data[request.auth.uid].status == 'approved';
        }

        // A rating is written under your own account id and nobody else's, so
        // nobody can rewrite what the rest of the family thought of a piece of
        // toast.
        function ratingsUntouchedOrMine() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ratings'])
            || (request.auth != null
                && request.resource.data.ratings.diff(resource.data.get('ratings', {}))
                     .affectedKeys().hasOnly([request.auth.uid]));
        }

        allow create: if saneTurn() && (familyOwner() || approvedMember());
        allow update: if saneTurn() && (familyOwner() || approvedMember()) && ratingsUntouchedOrMine();

        // Only as part of the owner clearing the whole family.
        allow delete: if familyOwner();
      }
    }
  }
}
