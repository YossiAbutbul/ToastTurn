rules_version = '2';

// Three ideas, and only three.
//
// 1. The family code says which rotation. Signing in says whether you are in
//    it. Nobody can go looking for families that are not theirs, so a code
//    that is never shared is never found, and a code on its own is an
//    invitation to ask rather than a window into the family: reading anything
//    at all needs an account. The one query allowed is an owner asking which
//    rotations are their own, which is how an account is a way back in.
// 2. One account runs the family. Only the signed-in owner can change the
//    people, the schedule or the rotation, or clear the family.
// 3. Everyone else may only ever act as themselves. Every phone has an account
//    of its own, given quietly and never asked for, and it says which person
//    in the rotation it is. The rules look that claim up and hold every write
//    to it: your order and your colour are yours.
service cloud.firestore {
  match /databases/{database}/documents {

    match /families/{familyId} {

      // ---- who is asking -------------------------------------------------
      //
      // These read the family and the membership list rather than the document
      // being written, because a turn or an order says nothing about who owns
      // the rotation. Repeated lookups of the same path are cached inside one
      // evaluation, so this costs one read of each, not one per call.

      function family() {
        return get(/databases/$(database)/documents/families/$(familyId)).data;
      }

      function familyOwner() {
        return request.auth != null && family().ownerUid == request.auth.uid;
      }

      /**
       * An account somebody actually signed into, rather than the one every
       * phone is handed without being asked. Running a rotation has to outlive
       * a wiped phone, and an anonymous account does not: it goes with the
       * browser cache, and takes the people and the schedule with it, beyond
       * anyone's reach. So owning a family is for real accounts only.
       *
       * Read off the identities rather than sign_in_provider. Signing in here
       * means linking Google onto the anonymous account the phone already had,
       * which keeps the same session: sign_in_provider goes on saying
       * "anonymous" for the rest of it, so asking that question refused the
       * very people it was meant to let in. What linking does change is the
       * identities, once the token has been refreshed.
       */
      function realAccount() {
        return request.auth != null
          && request.auth.token.firebase.identities.keys().size() > 0;
      }

      function members() {
        return get(/databases/$(database)/documents/families/$(familyId)/prefs/members).data;
      }

      function membership() {
        return members()[request.auth.uid];
      }

      /** Whether this phone has said which person in the rotation it is. */
      function claimed() {
        return request.auth != null
          && exists(/databases/$(database)/documents/families/$(familyId)/prefs/members)
          && members().keys().hasAny([request.auth.uid])
          && membership().get('personId', '') != '';
      }

      /**
       * Which person in the rotation the caller is. Only ever read after
       * claimed() has passed, so the entry is known to be there.
       */
      function myPersonId() {
        return membership().get('personId', '');
      }

      // ---- the family itself ---------------------------------------------

      // The people moved out into documents of their own, so the family no
      // longer carries a list of them and demanding one refused every write of
      // it. A family written before the move still has the field, and is still
      // held to a rotation of a sensible size.
      function sane() {
        return request.resource.data.name is string
          && request.resource.data.name.size() < 60
          && request.resource.data.get('people', []).size() <= 20
          && request.resource.data.get('removed', []).size() <= 100
          && request.resource.data.keys().hasOnly(
               ['ownerUid', 'ownerPersonId', 'name', 'people', 'schedule', 'removed', 'updatedAt']);
      }

      function isOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }

      // The people's names are in here, so a link on its own does not open it.
      allow get: if request.auth != null;

      // Your own rotations, and never anybody else's. Nothing here can be
      // swept: the rule is checked against every document a query could
      // return, so a query not held to `ownerUid == you` is refused outright
      // rather than filtered. A code nobody shared is still findable by
      // nobody.
      //
      // It is here because an account is the half of this that outlives a
      // wiped phone - the link does not - and without a way to ask "which are
      // mine" the owner signs back in, is recognised, and is still shown a
      // blank front door.
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // Publishing a family claims it for the account doing the publishing,
      // which has to be one that will still be there next month.
      allow create: if realAccount()
        && request.resource.data.ownerUid == request.auth.uid
        && sane();

      // The owner stays the owner: a write that moves ownerUid is refused.
      allow update: if isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && sane();

      allow delete: if isOwner();

      // Which person each account is: { uid: { personId, name, color } }.
      //
      // Nobody applies and nobody approves. Opening the link and tapping a name
      // is the whole of joining, so this is a claim rather than a request, and
      // the only rule about it is that it is yours: you may write your own key
      // and no other. Which name you claim is not policed, because a phone that
      // was wiped has to be able to say who it is again, and because knowing
      // the code already means being in the family.
      match /prefs/members {
        function mine() {
          return request.resource.data[request.auth.uid];
        }
        function myKeyOnly() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]);
        }
        function saneClaim() {
          return mine().personId is string
            && mine().personId.size() > 0
            && mine().personId.size() < 40
            && mine().get('name', '') is string
            && mine().get('name', '').size() < 40
            && mine().keys().hasOnly(['personId', 'name', 'color']);
        }

        allow get, list: if request.auth != null;

        allow create: if familyOwner()
          || (request.auth != null
              && request.resource.data.keys().hasOnly([request.auth.uid])
              && saneClaim());

        allow update: if familyOwner()
          || (request.auth != null && myKeyOnly() && saneClaim());

        allow delete: if familyOwner();
      }

      // What everyone wants, by person: { personId: { toastiness, butter } }.
      //
      // Keyed by person rather than by account, because half a family has no
      // phone: the owner puts an order in for a child who cannot. Everyone
      // else is held to the one line that belongs to them, which means looking
      // up which person they are before letting the write through.
      match /prefs/orders {
        /** True when the write only removes keys and adds nothing back. */
        function onlyRemovals() {
          return !request.resource.data.keys()
            .hasAny(request.resource.data.diff(resource.data).affectedKeys());
        }

        // Whoever is making it has to be able to read the lot.
        allow get, list: if request.auth != null;

        allow create: if familyOwner()
          || (claimed() && request.resource.data.keys().hasOnly([myPersonId()]));

        allow update: if familyOwner()
          || (claimed()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly([myPersonId()]))
          // Saying an order is made takes it off the board, and whoever is
          // making the toast is whoever's turn it is, not whoever runs the
          // rotation. So anyone in the rotation may take a line off - but
          // only take it off: a key that survives the write is a key being
          // written, and that is still each person's own.
          || (claimed() && onlyRemovals());

        allow delete: if familyOwner();
      }

      // The rotation, one document per person.
      //
      // A list on the family document could only ever be written whole, which
      // meant only the owner could touch it. A person of their own is
      // something the rules can talk about one at a time - which is what lets
      // somebody put themselves in the rotation without being handed the rest
      // of it.
      match /people/{personId} {
        function sanePerson() {
          return request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() < 40
            && request.resource.data.color is string
            && request.resource.data.color.size() < 32
            && request.resource.data.order is int
            && request.resource.data.active is bool
            && request.resource.data.keys().hasOnly(['name', 'color', 'order', 'active']);
        }

        allow get, list: if request.auth != null;

        // Putting yourself in the rotation is how somebody the owner never
        // wrote down joins it, so anyone in the family may add a person.
        allow create: if sanePerson() && request.auth != null;

        // Changing one is the owner's, or your own: a person nobody has
        // claimed is nobody's to rename.
        allow update: if sanePerson()
          && (familyOwner() || (claimed() && myPersonId() == personId));

        allow delete: if familyOwner();
      }

      match /turns/{turnId} {
        function saneTurn() {
          return request.resource.data.personId is string
            && request.resource.data.madeAt is string
            && request.resource.data.madeAt.size() < 40
            && request.resource.data.skipped is bool
            && request.resource.data.keys().hasOnly(
                 ['personId', 'madeAt', 'skipped', 'ratings', 'rating']);
        }

        // Anyone in the rotation may log the toast, because whoever pulls the
        // lever is rarely the person being credited — that is the whole point
        // of the lever. What nobody may do is reach back into a turn already
        // logged and change whose it was, or whether it counted, which would
        // hand them the rotation.
        function historyKept() {
          return request.resource.data.personId == resource.data.personId
            && request.resource.data.skipped == resource.data.skipped;
        }

        // A rating is written under your own account id and nobody else's, so
        // nobody can rewrite what the rest of the family thought of a piece of
        // toast.
        function ratingsUntouchedOrMine() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ratings'])
            || (request.auth != null
                && request.resource.data.ratings.diff(resource.data.get('ratings', {}))
                     .affectedKeys().hasOnly([request.auth.uid]));
        }

        allow get, list: if request.auth != null;

        allow create: if saneTurn() && (familyOwner() || claimed());
        allow update: if saneTurn() && historyKept()
          && (familyOwner() || claimed())
          && ratingsUntouchedOrMine();

        // Only as part of the owner clearing the whole family.
        allow delete: if familyOwner();
      }
    }
  }
}
