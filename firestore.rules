rules_version = '2';

// Two ideas, and only two.
//
// 1. The family code is the key. You have to know a family id to read it, and
//    nothing can list families, so a code that is never shared is never found.
// 2. The phone that started the family owns it. Only that phone can change the
//    people, the schedule or the rotation, or clear the family. Everyone with
//    the link can read it and log toast — that is the whole point of the app.
//
// The sign-in behind request.auth is anonymous: no account, no password, no
// email, nothing typed. It only exists to tell the owner's phone apart.
service cloud.firestore {
  match /databases/{database}/documents {

    match /families/{familyId} {
      function sane() {
        return request.resource.data.name is string
          && request.resource.data.name.size() < 60
          && request.resource.data.people is list
          && request.resource.data.people.size() <= 20;
      }

      function isOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }

      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && sane();

      // The owner stays the owner: a write that moves ownerUid is refused.
      allow update: if isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && sane();

      allow delete: if isOwner();

      match /turns/{turnId} {
        function saneTurn() {
          return request.resource.data.personId is string
            && request.resource.data.madeAt is string
            && request.resource.data.skipped is bool;
        }

        // Listing turns needs the family id in the path, so it stays scoped.
        allow get, list: if true;

        // Anyone in the family can say the toast got made.
        allow create, update: if request.auth != null && saneTurn();

        // Only as part of the owner clearing the whole family.
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
