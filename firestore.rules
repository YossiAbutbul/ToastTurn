rules_version = '2';

// Three ideas, and only three.
//
// 1. The family code says which rotation. Signing in says whether you are in
//    it. Nothing can list families, so a code that is never shared is never
//    found, and a code on its own is an invitation to ask rather than a window
//    into the family: reading anything at all needs an account.
// 2. One account runs the family. Only the signed-in owner can change the
//    people, the schedule or the rotation, or clear the family.
// 3. Everyone else may only ever act as themselves. The rules look up which
//    person in the rotation an account is, and hold every write to it: your
//    order and your colour. Being let in is not the same
//    as being allowed to be somebody else.
service cloud.firestore {
  match /databases/{database}/documents {

    match /families/{familyId} {

      // ---- who is asking -------------------------------------------------
      //
      // These read the family and the membership list rather than the document
      // being written, because a turn or an order says nothing about who owns
      // the rotation. Repeated lookups of the same path are cached inside one
      // evaluation, so this costs one read of each, not one per call.

      function family() {
        return get(/databases/$(database)/documents/families/$(familyId)).data;
      }

      function familyOwner() {
        return request.auth != null && family().ownerUid == request.auth.uid;
      }

      function members() {
        return get(/databases/$(database)/documents/families/$(familyId)/prefs/members).data;
      }

      function membership() {
        return members()[request.auth.uid];
      }

      function approvedMember() {
        return request.auth != null
          && exists(/databases/$(database)/documents/families/$(familyId)/prefs/members)
          && members().keys().hasAny([request.auth.uid])
          && membership().status == 'approved';
      }

      /**
       * Which person in the rotation the caller is. Only ever read after
       * approvedMember() has passed, so the entry is known to be there.
       */
      function myPersonId() {
        return membership().get('personId', '');
      }

      /** Whether some other account has been let into this rotation. */
      function approvedUid(uid) {
        return exists(/databases/$(database)/documents/families/$(familyId)/prefs/members)
          && members().keys().hasAny([uid])
          && members()[uid].get('status', '') == 'approved';
      }

      // ---- the family itself ---------------------------------------------

      function sane() {
        return request.resource.data.name is string
          && request.resource.data.name.size() < 60
          && request.resource.data.people is list
          && request.resource.data.people.size() <= 20
          && request.resource.data.get('removed', []).size() <= 100
          && request.resource.data.keys().hasOnly(
               ['ownerUid', 'ownerPersonId', 'name', 'people', 'schedule', 'removed', 'updatedAt']);
      }

      function isOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }

      // The people's names are in here, so a link on its own does not open it.
      allow get: if request.auth != null;
      allow list: if false;

      // Publishing a family claims it for the account doing the publishing.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && sane();

      // The owner may hand the rotation on, and only they may: it moves by
      // their own write or not at all, and only to somebody already let in.
      // Anything else leaves ownerUid exactly where it was.
      allow update: if isOwner() && sane()
        && (request.resource.data.ownerUid == resource.data.ownerUid
            || approvedUid(request.resource.data.ownerUid));

      allow delete: if isOwner();

      // Who is in the rotation, by account: { uid: { status, personId, email } }.
      //
      // Having the link lets you ask. It does not let you in: you may only ever
      // write your own key, and only as "pending". Moving anyone to "approved"
      // is the owner's alone, and so is choosing which person an account is —
      // once set, not even that account may move it, or being let in as
      // yourself would be a way of becoming anybody.
      match /prefs/members {
        function mine() {
          return request.resource.data[request.auth.uid];
        }
        function myOld() {
          return resource.data[request.auth.uid];
        }
        function myKeyOnly() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]);
        }
        function alreadyApproved() {
          return resource.data.keys().hasAny([request.auth.uid])
            && myOld().status == 'approved';
        }

        // What you say about yourself is your own name and your own address.
        // The owner reads both on the approval screen and decides from them, so
        // an address that is not the one you signed in with is refused.
        function saneEntry() {
          return mine().get('name', '') is string
            && mine().get('name', '').size() < 60
            && (mine().get('email', null) == null
                || mine().get('email', null) == request.auth.token.get('email', null));
        }

        // Asking to join says who you are. It cannot say which person in the
        // rotation you are: that is the owner's to decide, at approval.
        function validAsk() {
          return mine().status == 'pending'
            && mine().get('personId', null) == null
            && saneEntry();
        }

        // Once you are in, your colour is the only thing about yourself you may
        // change. Moving your own personId would make you somebody else, with
        // their orders and their answers to give.
        function validSelfEdit() {
          return mine().status == 'approved'
            && mine().get('personId', null) == myOld().get('personId', null)
            && saneEntry();
        }

        // Everyone's address is in here, so this needs an account too.
        allow get, list: if request.auth != null;

        // The owner writes this doc freely, it is how they let people in.
        allow create: if familyOwner()
          || (request.auth != null
              && request.resource.data.keys().hasOnly([request.auth.uid])
              && validAsk());

        allow update: if familyOwner()
          || (request.auth != null && myKeyOnly()
              && (alreadyApproved() ? validSelfEdit() : validAsk()));

        allow delete: if familyOwner();
      }

      // Which slices have been made: { personId: [0, 2] }.
      //
      // Whoever is making the toast ticks off everyone's, and the maker is
      // whoever's turn it is rather than whoever runs the rotation. So this
      // board is open to the whole family, unlike the orders themselves,
      // which stay each person's own.
      match /prefs/made {
        allow get, list: if request.auth != null;
        allow create, update: if familyOwner() || approvedMember();
        allow delete: if familyOwner();
      }

      // What everyone wants, by person: { personId: { toastiness, butter } }.
      //
      // Keyed by person rather than by account, because half a family has no
      // phone: the owner puts an order in for a child who cannot. Everyone
      // else is held to the one line that belongs to them, which means looking
      // up which person they are before letting the write through.
      match /prefs/orders {
        // Whoever is making it has to be able to read the lot.
        allow get, list: if request.auth != null;

        allow create: if familyOwner()
          || (approvedMember()
              && request.resource.data.keys().hasOnly([myPersonId()]));

        allow update: if familyOwner()
          || (approvedMember()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly([myPersonId()]));

        allow delete: if familyOwner();
      }

      match /turns/{turnId} {
        function saneTurn() {
          return request.resource.data.personId is string
            && request.resource.data.madeAt is string
            && request.resource.data.madeAt.size() < 40
            && request.resource.data.skipped is bool
            && request.resource.data.keys().hasOnly(
                 ['personId', 'madeAt', 'skipped', 'ratings', 'rating']);
        }

        // Anyone in the rotation may log the toast, because whoever pulls the
        // lever is rarely the person being credited — that is the whole point
        // of the lever. What nobody may do is reach back into a turn already
        // logged and change whose it was, or whether it counted, which would
        // hand them the rotation.
        function historyKept() {
          return request.resource.data.personId == resource.data.personId
            && request.resource.data.skipped == resource.data.skipped;
        }

        // A rating is written under your own account id and nobody else's, so
        // nobody can rewrite what the rest of the family thought of a piece of
        // toast.
        function ratingsUntouchedOrMine() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ratings'])
            || (request.auth != null
                && request.resource.data.ratings.diff(resource.data.get('ratings', {}))
                     .affectedKeys().hasOnly([request.auth.uid]));
        }

        allow get, list: if request.auth != null;

        allow create: if saneTurn() && (familyOwner() || approvedMember());
        allow update: if saneTurn() && historyKept()
          && (familyOwner() || approvedMember())
          && ratingsUntouchedOrMine();

        // Only as part of the owner clearing the whole family.
        allow delete: if familyOwner();
      }
    }
  }
}
