rules_version = '2';

// Two ideas, and only two.
//
// 1. The family code is the key. You have to know a family id to read it, and
//    nothing can list families, so a code that is never shared is never found.
//    Anyone with the link can read the family and say the toast got made — no
//    sign-in, nothing typed. That is the whole point of the app.
// 2. One account runs the family. Only the signed-in owner can change the
//    people, the schedule or the rotation, or clear the family.
service cloud.firestore {
  match /databases/{database}/documents {

    match /families/{familyId} {
      function sane() {
        return request.resource.data.name is string
          && request.resource.data.name.size() < 60
          && request.resource.data.people is list
          && request.resource.data.people.size() <= 20;
      }

      function isOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }

      allow get: if true;
      allow list: if false;

      // Publishing a family claims it for the account doing the publishing.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && sane();

      // The owner stays the owner: a write that moves ownerUid is refused.
      allow update: if isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && sane();

      allow delete: if isOwner();

      match /turns/{turnId} {
        function saneTurn() {
          return request.resource.data.personId is string
            && request.resource.data.madeAt is string
            && request.resource.data.skipped is bool;
        }

        // Listing turns needs the family id in the path, so it stays scoped.
        allow get, list: if true;

        // Anyone in the family can log toast without signing in.
        allow create, update: if saneTurn();

        // Only as part of the owner clearing the whole family.
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
